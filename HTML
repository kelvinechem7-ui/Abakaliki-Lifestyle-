<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport"
content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

<title>Abakaliki Lifestyle</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    overflow: hidden;
    font-family: Arial, sans-serif;
    background: #111827;
    color: white;
    touch-action: none;
}

#game {
    position: fixed;
    inset: 0;
}

canvas {
    display: block;
}

#topbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    padding: 15px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    pointer-events: none;
    background: linear-gradient(
        to bottom,
        rgba(0,0,0,0.65),
        transparent
    );
}

.logo {
    font-size: 17px;
    font-weight: 900;
    color: #facc15;
}

.subtitle {
    font-size: 10px;
    margin-top: 4px;
    letter-spacing: 1px;
}

.money {
    background: #166534;
    padding: 9px 12px;
    border-radius: 10px;
    font-weight: bold;
    border: 1px solid #4ade80;
}

#location {
    position: fixed;
    top: 88px;
    left: 15px;
    background: rgba(0,0,0,0.6);
    padding: 8px 12px;
    border-radius: 8px;
    font-size: 12px;
}

#message {
    position: fixed;
    top: 130px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0,0,0,0.75);
    border: 1px solid #facc15;
    border-radius: 10px;
    padding: 10px 15px;
    font-size: 12px;
    text-align: center;
    width: max-content;
    max-width: 90%;
}

#controls {
    position: fixed;
    bottom: 25px;
    left: 20px;
    width: 140px;
    height: 140px;
}

#joystick {
    width: 140px;
    height: 140px;
    background: rgba(255,255,255,0.12);
    border: 2px solid rgba(255,255,255,0.4);
    border-radius: 50%;
    position: relative;
    touch-action: none;
}

#stick {
    position: absolute;
    width: 55px;
    height: 55px;
    background: rgba(250,204,21,0.85);
    border: 2px solid white;
    border-radius: 50%;
    left: 40px;
    top: 40px;
    pointer-events: none;
}

#actions {
    position: fixed;
    bottom: 35px;
    right: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.action {
    width: 82px;
    height: 55px;
    border-radius: 14px;
    border: 2px solid white;
    color: white;
    background: rgba(0,0,0,0.65);
    font-weight: bold;
    font-size: 12px;
    touch-action: manipulation;
}

#interact {
    background: #b45309;
}

#help {
    position: fixed;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 10px;
    white-space: nowrap;
    color: #fff;
    opacity: 0.8;
}

#loading {
    position: fixed;
    inset: 0;
    z-index: 10;
    background: #111827;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 25px;
}

#loading h2 {
    color: #facc15;
}

@media (max-width: 380px) {
    #controls {
        width: 115px;
        height: 115px;
    }

    #joystick {
        width: 115px;
        height: 115px;
    }

    #stick {
        left: 30px;
        top: 30px;
    }

    #actions {
        right: 10px;
    }

    .action {
        width: 70px;
    }
}
</style>
</head>

<body>

<div id="game"></div>

<div id="loading">
    <div>
        <h2>ABAKALIKI LIFESTYLE 🇳🇬</h2>
        <p>Building your city...</p>
        <small>Please wait for the 3D world to load.</small>
    </div>
</div>

<div id="topbar">
    <div>
        <div class="logo">ABAKALIKI LIFESTYLE</div>
        <div class="subtitle">YOUR CITY. YOUR LIFE. YOUR STORY.</div>
    </div>

    <div class="money">₦<span id="cash">50000</span></div>
</div>

<div id="location">📍 Abakaliki City</div>

<div id="message">Welcome to Abakaliki! Explore your city.</div>

<div id="controls">
    <div id="joystick">
        <div id="stick"></div>
    </div>
</div>

<div id="actions">
    <button class="action" id="run">🏃 RUN</button>
    <button class="action" id="interact">👋 ACTION</button>
</div>

<div id="help">Move with the joystick • Explore the city</div>

<script type="importmap">
{
    "imports": {
        "three": "https://cdn.jsdelivr.net/npm/three@0.179.1/build/three.module.js"
    }
}
</script>

<script type="module">
import * as THREE from "three";

const container = document.getElementById("game");
const message = document.getElementById("message");
const loading = document.getElementById("loading");

const scene = new THREE.Scene();
scene.background = new THREE.Color(0x87ceeb);
scene.fog = new THREE.Fog(0x87ceeb, 45, 150);

const camera = new THREE.PerspectiveCamera(
    65,
    window.innerWidth / window.innerHeight,
    0.1,
    300
);

const renderer = new THREE.WebGLRenderer({
    antialias: false,
    powerPreference: "high-performance"
});

renderer.setSize(window.innerWidth, window.innerHeight);
renderer.setPixelRatio(
    Math.min(window.devicePixelRatio, 1.5)
);

renderer.outputColorSpace = THREE.SRGBColorSpace;
container.appendChild(renderer.domElement);

// LIGHTING

scene.add(new THREE.HemisphereLight(0xffffff, 0x53634c, 2));

const sunlight = new THREE.DirectionalLight(0xffffff, 2);
sunlight.position.set(30, 60, 20);
scene.add(sunlight);

// MATERIALS

function material(color) {
    return new THREE.MeshStandardMaterial({ color });
}

const grassMat = material(0x6b9b50);
const roadMat = material(0x34383d);
const pavementMat = material(0xc6c2b5);
const whiteMat = material(0xffffff);

// GROUND

const ground = new THREE.Mesh(
    new THREE.PlaneGeometry(220, 220),
    grassMat
);

ground.rotation.x = -Math.PI / 2;
ground.position.y = -0.12;
scene.add(ground);

// ROADS

function road(x, z, width, depth) {
    const mesh = new THREE.Mesh(
        new THREE.BoxGeometry(width, 0.12, depth),
        roadMat
    );

    mesh.position.set(x, 0, z);
    scene.add(mesh);
}

road(0, 0, 220, 13);
road(0, 0, 13, 220);
road(0, 42, 220, 9);
road(42, 0, 9, 220);
road(-42, 0, 9, 220);
road(0, -42, 220, 9);

// ROAD MARKINGS

function roadLine(x, z, width, depth) {
    const line = new THREE.Mesh(
        new THREE.BoxGeometry(width, 0.035, depth),
        whiteMat
    );

    line.position.set(x, 0.075, z);
    scene.add(line);
}

for (let i = -100; i <= 100; i += 12) {
    roadLine(i, 0, 5, 0.16);
    roadLine(0, i, 0.16, 5);
}

// BUILDINGS

const buildings = [];

const buildingColors = [
    0xe8d5b7,
    0xf1e7d0,
    0xd9e2e8,
    0xd8c3a5,
    0xe5c5bd,
    0xb8d5c8,
    0xf0d68a,
    0xd5d5d5
];

function createBuilding(x, z, w, h, d, index) {
    const group = new THREE.Group();

    const body = new THREE.Mesh(
        new THREE.BoxGeometry(w, h, d),
        material(buildingColors[index % buildingColors.length])
    );

    body.position.y = h / 2;
    group.add(body);

    const roof = new THREE.Mesh(
        new THREE.BoxGeometry(w + 0.4, 0.4, d + 0.4),
        material(0x777777)
    );

    roof.position.y = h + 0.2;
    group.add(roof);

    // Front door

    const door = new THREE.Mesh(
        new THREE.BoxGeometry(1.1, 2.2, 0.12),
        material(0x69452e)
    );

    door.position.set(0, 1.1, d / 2 + 0.07);
    group.add(door);

    // Windows

    const windowMat = material(0x4c9bbd);

    for (let y = 3; y < h - 1; y += 3) {
        for (let xx = -w / 2 + 1.5; xx < w / 2; xx += 3) {
            const win = new THREE.Mesh(
                new THREE.BoxGeometry(1.1, 1.2, 0.1),
                windowMat
            );

            win.position.set(xx, y, d / 2 + 0.07);
            group.add(win);
        }
    }

    group.position.set(x, 0, z);
    scene.add(group);

    buildings.push({
        x,
        z,
        w,
        d,
        name: "City Building"
    });

    return group;
}

let buildingIndex = 0;

for (let x = -90; x <= 90; x += 23) {
    for (let z = -90; z <= 90; z += 23) {

        if (Math.abs(x) < 15 || Math.abs(z) < 15) {
            continue;
        }

        if (
            Math.abs(x - 42) < 12 ||
            Math.abs(x + 42) < 12
        ) {
            continue;
        }

        const w = 9 + (buildingIndex % 3);
        const d = 9 + ((buildingIndex + 1) % 3);
        const h = 7 + (buildingIndex % 4) * 2;

        createBuilding(x, z, w, h, d, buildingIndex);

        buildingIndex++;
    }
}

// TREES

function createTree(x, z) {
    const tree = new THREE.Group();

    const trunk = new THREE.Mesh(
        new THREE.CylinderGeometry(0.3, 0.45, 2.5, 6),
        material(0x79502b)
    );

    trunk.position.y = 1.25;
    tree.add(trunk);

    const leaves = new THREE.Mesh(
        new THREE.SphereGeometry(1.8, 7, 6),
        material(0x26733b)
    );

    leaves.position.y = 3.5;
    tree.add(leaves);

    tree.position.set(x, 0, z);
    scene.add(tree);
}

for (let x = -90; x <= 90; x += 15) {
    for (let z = -90; z <= 90; z += 15) {
        if (
            Math.abs(x) > 12 &&
            Math.abs(z) > 12 &&
            Math.abs(x) < 100 &&
            Math.abs(z) < 100 &&
            Math.abs(x - 42) > 8 &&
            Math.abs(x + 42) > 8
        ) {
            if ((Math.abs(x + z) % 3) === 0) {
                createTree(x, z);
            }
        }
    }
}

// PLAYER

const player = new THREE.Group();

const skin = material(0x8d5524);
const shirt = material(0x1769aa);
const trousers = material(0x222c3c);
const shoes = material(0x171717);

const body = new THREE.Mesh(
    new THREE.BoxGeometry(0.9, 1.2, 0.55),
    shirt
);

body.position.y = 1.8;
player.add(body);

const head = new THREE.Mesh(
    new THREE.SphereGeometry(0.38, 10, 8),
    skin
);

head.position.y = 2.65;
player.add(head);

const legs = [];

for (const side of [-1, 1]) {
    const leg = new THREE.Mesh(
        new THREE.BoxGeometry(0.32, 0.9, 0.38),
        trousers
    );

    leg.position.set(side * 0.23, 0.85, 0);
    player.add(leg);
    legs.push(leg);

    const shoe = new THREE.Mesh(
        new THREE.BoxGeometry(0.34, 0.18, 0.48),
        shoes
    );

    shoe.position.set(side * 0.23, 0.32, -0.05);
    player.add(shoe);
}

player.position.set(0, 0, 5);
scene.add(player);

// MOVEMENT

let moveX = 0;
let moveY = 0;
let running = false;
let animationTime = 0;

const joystick = document.getElementById("joystick");
const stick = document.getElementById("stick");

let activePointer = null;

function updateJoystick(event) {
    const rect = joystick.getBoundingClientRect();

    const cx = rect.left + rect.width / 2;
    const cy = rect.top + rect.height / 2;

    let dx = event.clientX - cx;
    let dy = event.clientY - cy;

    const max = rect.width * 0.30;
    const length = Math.hypot(dx, dy);

    if (length > max) {
        dx = dx / length * max;
        dy = dy / length * max;
    }

    moveX = dx / max;
    moveY = dy / max;

    stick.style.left =
        (rect.width / 2 + dx - 27.5) + "px";

    stick.style.top =
        (rect.height / 2 + dy - 27.5) + "px";
}

function resetJoystick() {
    activePointer = null;
    moveX = 0;
    moveY = 0;

    stick.style.left =
        (joystick.clientWidth / 2 - 27.5) + "px";

    stick.style.top =
        (joystick.clientHeight / 2 - 27.5) + "px";
}

joystick.addEventListener("pointerdown", event => {
    event.preventDefault();

    activePointer = event.pointerId;
    joystick.setPointerCapture(event.pointerId);

    updateJoystick(event);
});

joystick.addEventListener("pointermove", event => {
    if (event.pointerId === activePointer) {
        updateJoystick(event);
    }
});

joystick.addEventListener("pointerup", resetJoystick);
joystick.addEventListener("pointercancel", resetJoystick);

document.getElementById("run").addEventListener("pointerdown", () => {
    running = true;
});

document.getElementById("run").addEventListener("pointerup", () => {
    running = false;
});

document.getElementById("run").addEventListener("pointercancel", () => {
    running = false;
});

document.getElementById("run").addEventListener("pointerleave", () => {
    running = false;
});

// KEYBOARD SUPPORT

const keys = {};

window.addEventListener("keydown", event => {
    keys[event.key.toLowerCase()] = true;
});

window.addEventListener("keyup", event => {
    keys[event.key.toLowerCase()] = false;
});

// ACTION BUTTON

let cash = 50000;

document.getElementById("interact").addEventListener("click", () => {
    let nearest = null;
    let distance = Infinity;

    for (const building of buildings) {
        const d = Math.hypot(
            player.position.x - building.x,
            player.position.z - building.z
        );

        if (d < distance) {
            distance = d;
            nearest = building;
        }
    }

    if (nearest && distance < 12) {
        message.textContent =
            "🏠 You are near a building! More activities coming soon.";
    } else {
        message.textContent =
            "👋 Welcome to Abakaliki! Explore the city and discover new places.";
    }

    cash += 100;
    document.getElementById("cash").textContent =
        cash.toLocaleString("en-NG");

    setTimeout(() => {
        message.textContent = "Explore Abakaliki and build your lifestyle!";
    }, 3500);
});

// CAMERA

const cameraOffset = new THREE.Vector3(0, 8, 12);

camera.position.set(
    player.position.x,
    player.position.y + 8,
    player.position.z + 12
);

camera.lookAt(player.position);

// GAME LOOP

function animate() {
    requestAnimationFrame(animate);

    let x = moveX;
    let z = moveY;

    if (keys["w"] || keys["arrowup"]) z -= 1;
    if (keys["s"] || keys["arrowdown"]) z += 1;
    if (keys["a"] || keys["arrowleft"]) x -= 1;
    if (keys["d"] || keys["arrowright"]) x += 1;

    const length = Math.hypot(x, z);

    if (length > 1) {
        x /= length;
        z /= length;
    }

    const moving = Math.hypot(x, z) > 0.08;
    const speed = running ? 0.18 : 0.09;

    if (moving) {
        player.position.x += x * speed;
        player.position.z += z * speed;

        player.rotation.y = Math.atan2(x, z);

        animationTime += 0.18;

        legs[0].rotation.x = Math.sin(animationTime) * 0.45;
        legs[1].rotation.x = -Math.sin(animationTime) * 0.45;
    } else {
        legs[0].rotation.x = 0;
        legs[1].rotation.x = 0;
    }

    // Keep the player inside the city

    player.position.x = THREE.MathUtils.clamp(
        player.position.x, -105, 105
    );

    player.position.z = THREE.MathUtils.clamp(
        player.position.z, -105, 105
    );

    // Follow player with camera

    const targetCamera = new THREE.Vector3(
        player.position.x,
        player.position.y + 7,
        player.position.z + 10
    );

    camera.position.lerp(targetCamera, 0.12);

    camera.lookAt(
        player.position.x,
        player.position.y + 1,
        player.position.z
    );

    renderer.render(scene, camera);
}

window.addEventListener("resize", () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();

    renderer.setSize(window.innerWidth, window.innerHeight);
});

animate();

loading.style.display = "none";

message.textContent =
    "Welcome to Abakaliki! Use the joystick to move.";

</script>

</body>
</html>
